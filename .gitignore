# Data hygiene (CLAUDE.md sections 4 and 9): raw, interim and processed data is
# never committed. Split manifests ARE committed -- they are what makes a split
# citable and reproducible without redistributing the data itself.
data/raw/
# ...but the provenance manifest IS committed: it records every raw file's
# source, pinned revision, SHA-256, licence and citation, so the fetch is
# reproducible and auditable without redistributing the corpora themselves.
!data/raw/
!data/raw/MANIFEST.json
data/raw/*
!data/raw/MANIFEST.json
data/interim/
data/processed/*
!data/processed/manifests/
!data/processed/manifests/**

# Warehouse DB holds sentences (same rule as processed/). Schema and queries
# are committed; the SQLite file is not.  [298-70]
data/warehouse/*.sqlite
data/warehouse/*.sqlite-wal
data/warehouse/*.sqlite-shm
data/warehouse/*.duckdb

# Model weights and training byproducts
*.pt
*.safetensors
*.bin
checkpoints/
out/
wandb/

# runs/*.json IS committed -- it is the GPU-hour evidence for the report.

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/
.env

# OS / editor
.DS_Store
.vscode/

# Derived supervision for MLX LoRA: rebuildable from the frozen splits with
# scripts/build_sft_data.py, so the JSONL is not committed. Its manifest is,
# because it records the prompt, and changing the prompt changes the measurement.
data/sft/*
!data/sft/*/
data/sft/*/*.jsonl
!data/sft/*/manifest.json

# MLX adapters and merged weights: large, and rebuildable from a recorded run.
models/adapters/
